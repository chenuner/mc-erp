{
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=mc_erp;Username=postgres;Password=postgres"
  },
  "Storage": {
    "RootPath": "storage-files"
  },
  "Jwt": {
    "Issuer": "mc-erp",
    "Audience": "mc-erp-client",
    "SecretKey": "CHANGE_ME_TO_A_LONG_RANDOM_SECRET_KEY_AT_LEAST_32_BYTES_LONG_1234567890",
    "ExpiryMinutes": 480
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}

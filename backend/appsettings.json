{
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=mc_erp;Username=postgres;Password=postgres"
  },
  "Storage": {
    "__doc": {
      "RootPath": "上传文件保存目录，相对进程工作目录；生产由 docker-compose 覆盖成 /app/storage-files（volume storage 挂载，持久化）",
      "TempPath": "临时缓冲目录，不配则用系统临时目录（容器是 /tmp）；只放上传中的大文件和打包中的 ZIP，请求结束即删，无需备份"
    },
    "RootPath": "storage-files"
  },
  "Jwt": {
    "Issuer": "mc-erp",
    "Audience": "mc-erp-client",
    "SecretKey": "CHANGE_ME_TO_A_LONG_RANDOM_SECRET_KEY_AT_LEAST_32_BYTES_LONG_1234567890",
    "ExpiryMinutes": 480
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
